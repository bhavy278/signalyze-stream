# MongoDB Atlas connection string (or a local mongodb:// URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/signalyze

# OpenAI API key — used for analysis, embeddings, and chat
OPENAI_API_KEY=sk-...

# JWT signing secret — 64-char hex, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-64-char-hex-secret
